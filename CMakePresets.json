{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 / Qt 5 / GStreamer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.phase2/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": true,
        "NULLOY_SKINS": true,
        "NULLOY_GSTREAMER": true,
        "NULLOY_GSTREAMER_TAGREADER": false,
        "NULLOY_TAGLIB": true,
        "NULLOY_VLC": false,
        "NULLOY_UPDATE_CHECK": false,
        "NULLOY_CONSOLE": false
      }
    }
  ],
  "buildPresets": [{ "name": "windows-x64", "configurePreset": "windows-x64", "jobs": 4 }],
  "testPresets": [{ "name": "windows-x64", "configurePreset": "windows-x64", "output": { "outputOnFailure": true } }]
}
